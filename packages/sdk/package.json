{
  "name": "web-sdk-pp-doclayoutv3",
  "version": "1.1.0",
  "description": "Browser-first PP-DocLayoutV3 layout detection SDK powered by ONNX Runtime Web",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenmohan123/web-sdk-PP-DocLayoutV3.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "unpkg": "./dist/browser-global.js",
  "jsdelivr": "./dist/browser-global.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./inference.worker.js": "./dist/inference.worker.js"
  },
  "dependencies": {
    "onnxruntime-web": "1.27.0"
  },
  "scripts": {
    "api:report": "api-extractor run",
    "build": "tsup --config tsup.config.ts && pnpm api:report",
    "lint": "eslint src tests",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.58.12",
    "eslint": "9.39.5",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
